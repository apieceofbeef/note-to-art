# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: override the model. Defaults to gpt-4o-mini (cheap + fast).
# OPENAI_MODEL=gpt-4o-mini

# Supabase (required for login + history; the generator works without these).
# Get these from your Supabase project at Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional: base URL used as the magic-link `emailRedirectTo`. If unset, the
# server falls back to the request host (works for localhost). Set this in
# production (e.g. https://note-to-art.vercel.app) so magic links resolve to
# the right origin.
# NEXT_PUBLIC_SITE_URL=https://your-deploy-url.example.com
